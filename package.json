{
  "name": "software-house",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web",
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace=web",
    "build:api": "npm run build --workspace=api",
    "db:generate": "npm run db:generate -w api",
    "db:migrate": "npm run db:migrate -w api",
    "db:push": "npm run db:push -w api",
    "db:studio": "npm run db:studio -w api",
    "db:seed": "npm run db:seed -w api",
    "seed:admin": "npm run seed:admin -w api"
  },
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*"
  ]
}
