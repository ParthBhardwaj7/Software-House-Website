# Dependencies — never copy node_modules into the build context
node_modules
apps/*/node_modules

# Build outputs — rebuilt inside Docker
dist
apps/*/dist
.next
apps/*/.next
out

# Git
.git
.gitignore
.github

# Environment files — secrets must NEVER go into an image
.env
.env.*
apps/**/.env
apps/**/.env.*

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
.vscode
*.swp

# Test outputs
coverage
apps/*/coverage

# TypeScript incremental build cache
*.tsbuildinfo

# Turbo
.turbo
