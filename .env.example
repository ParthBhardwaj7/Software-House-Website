# Backend (apps/api) - copy to apps/api/.env
DATABASE_URL="postgresql://user:password@localhost:5432/software_house?schema=public"
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32"
PORT=3001

# Admin panel credentials — set before first Docker start, then update via /anish panel
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="YourStrongPassword123!"

# Optional: pre-seed site name / contact info (can also be set via admin panel)
# SITE_NAME="Your Company Name"
# CONTACT_EMAIL="info@yourdomain.com"
# CONTACT_PHONE="+91 98765 43210"

# Frontend (apps/web) - copy to apps/web/.env.local
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
# Leave empty to hide the WhatsApp button unless set in Admin
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Razorpay Key ID (publishable) — must match API RAZORPAY_KEY_ID for /pay checkout
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...

# Cloudflare Turnstile (web app env) — use with TURNSTILE_SECRET_KEY on the same deployment
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
