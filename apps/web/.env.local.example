NEXT_PUBLIC_API_URL=http://localhost:3001
# Public site origin (no trailing slash) — required for correct canonical URLs, sitemap, manifest icons, and OG URLs in production
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# Optional: absolute or path to a 1200×630 image; else /opengraph-image is used
# NEXT_PUBLIC_OG_IMAGE=
# Dev/QA: dummy blog posts on /blog, post pages, and sitemap when API has no posts (off in production unless set)
# NEXT_PUBLIC_USE_DUMMY_SITEMAP=true
# Digits only or with +/spaces — floating button hidden if empty here and in Admin → WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Same Key ID as RAZORPAY_KEY_ID on the API (publishable). Omit to show “payments not enabled” on /pay.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...

# Cloudflare Turnstile — set BOTH site key (public) and secret (below) in production to protect contact, newsletter, pay.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAA...   # server-only; add in Vercel/host env, not NEXT_PUBLIC

# Cloudinary — for admin image uploads (upload from computer)
# Cloud name from: cloudinary.com/console (top-left)
# Upload preset: Settings → Upload → Upload presets → Add preset → Signing mode: Unsigned
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
