DATABASE_URL="postgresql://user:password@localhost:5432/your_db?schema=public"
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32"
PORT=3001

# Production: set to your Next.js site origin (single URL or comma-separated). If unset, all origins are allowed (see startup warning).
# CORS_ORIGIN=https://yourdomain.com

# Razorpay (optional — required for /payments/razorpay/* and the public /pay page flow)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...   # Dashboard → Webhooks → secret; endpoint POST /payments/razorpay/webhook

# When the API runs behind nginx/Cloudflare/Vercel proxy, set to 1 so rate limits use the real client IP.
# TRUST_PROXY=1
